# Copy to .env and fill in the provider you use. .env is gitignored.
# Exported shell variables always win over anything set here.
RECEIPT_RENAMER_PROVIDER=openai
# Optional: default model when --model is omitted.
# RECEIPT_RENAMER_MODEL=
# Optional: default filename layout when --name-format is omitted.
#   date-first     -> 2024-03-14 Blue Bottle Coffee - Meals.jpg  (default)
#   business-first -> Blue Bottle Coffee - Meals - 03-14-2024.jpg
# RECEIPT_RENAMER_NAME_FORMAT=date-first

# --- Public OpenAI -----------------------------------------------------------
OPENAI_API_KEY=
# Optional: point the SDK at an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=

# --- Azure OpenAI (RECEIPT_RENAMER_PROVIDER=azure) ---------------------------
# Resource root. Values ending in /openai or /openai/v1 are trimmed automatically.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# The DEPLOYMENT name from Azure AI Studio, which may differ from the model name.
# Getting this wrong gives "404 Resource not found" on every file.
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21
# Use a key, OR leave it blank and authenticate with Entra ID via `az login`.
# AZURE_OPENAI_API_KEY=

# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=
